# Скопіюйте цей файл у .env і заповніть своїми значеннями.
# Фонограми, ціни, реквізити та тексти редагуються в Contentful, а не тут.

# Токен від @BotFather
BOT_TOKEN=123456789:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA

# Довільний рядок (A-Z, a-z, 0-9, _ і -), яким Telegram підписує запити на webhook
WEBHOOK_SECRET=change-me-to-random-string

# Telegram ID тих, хто підтверджує оплати, через кому (свій ID можна дізнатися у @userinfobot).
# Кожен адмін має хоча б раз натиснути /start у боті.
ADMIN_IDS=111111111

TIMEZONE=Europe/Kyiv

# --- Contentful ---
# Settings → API keys → Add API key: Space ID і Content Delivery API access token
CONTENTFUL_SPACE_ID=your-space-id
CONTENTFUL_DELIVERY_ACCESS_TOKEN=your-delivery-api-token
CONTENTFUL_ENVIRONMENT=master
# Порожньо — локаль простору за замовчуванням
CONTENTFUL_LOCALE=

# Скільки секунд бот тримає дані з Contentful у кеші. З вебхуком (нижче) зміни видно одразу.
CONTENTFUL_CACHE_TTL=300

# Секрет для public/contentful-webhook.php (заголовок X-Webhook-Secret у налаштуваннях вебхука)
CONTENTFUL_WEBHOOK_SECRET=change-me-too

# Потрібен лише для одноразового запуску bin/contentful-setup.php
# (Settings → CMA tokens). Після налаштування можна видалити.
CONTENTFUL_MANAGEMENT_TOKEN=

# --- MySQL ---
# Створіть порожню базу й користувача, таблиці бот створить сам:
#   CREATE DATABASE yohanan_bot CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
#   CREATE USER 'yohanan_bot'@'localhost' IDENTIFIED BY 'пароль';
#   GRANT ALL PRIVILEGES ON yohanan_bot.* TO 'yohanan_bot'@'localhost';
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=yohanan_bot
DB_USER=yohanan_bot
DB_PASSWORD=change-me

# --- Завантаження WAV ---
# Адреса бота в інтернеті: з неї формуються посилання на WAV, більші за 50 МБ (ліміт Telegram)
APP_URL=https://yohanan.rdlab.com.ua
# Ключ для підпису посилань на завантаження (довільний довгий рядок)
DOWNLOAD_SECRET=change-me
# Папка з WAV на сервері (відносна — від кореня проєкту). Імена — як у MP3, але з .wav
WAV_DIR=wav

# Шляхи для службових файлів (відносні — від кореня проєкту)
CACHE_PATH=storage/cache/contentful.json
LOG_PATH=storage/logs/bot.log
